# Optional overrides for the LOCAL development Compose stack.
# Secrets for JWT/PostgreSQL are automatically generated into a Docker volume.
TENLITH_PUBLIC_URL=http://localhost:8080
TENLITH_WEB_PORT=8080
TENLITH_DEMO_ENABLED=true
TENLITH_BILLING_SIMULATION=true
# Change together if this subnet overlaps another Docker/VPN network.
TENLITH_SUBNET=172.30.227.0/24
TENLITH_PROXY_IP=172.30.227.10
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
